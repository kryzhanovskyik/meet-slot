# PostgreSQL connection string.
# For local Postgres started via `docker compose up postgres` (or `docker-compose.yml`), use:
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/booking_db?schema=public"

# Secret used to sign session JWTs. Use a long random value in any real deployment.
JWT_SECRET="dev-secret-change-me"

# Base URL used to build the email-confirmation link printed to the server console.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
